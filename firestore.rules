rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers basicos
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Lee el rol del usuario autenticado desde /users/{uid}
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isBroker() {
      return signedIn() && userRole() == 'broker';
    }

    function isAgent() {
      return signedIn() && userRole() == 'agent';
    }

    // Verifica que el agente pertenece al broker autenticado
    function agentOwnedByMe(agentId) {
      return exists(/databases/$(database)/documents/agents/$(agentId))
          && get(/databases/$(database)/documents/agents/$(agentId)).data.brokerId == uid();
    }

    // /users/{userId}
    match /users/{userId} {
      allow read:   if signedIn() && (uid() == userId || isBroker());
      allow create: if signedIn() && uid() == userId;
      allow update: if signedIn() && uid() == userId;
      allow delete: if false;
    }

    // /brokers/{brokerId}
    match /brokers/{brokerId} {
      allow read, write: if signedIn() && uid() == brokerId;
    }

    // /agents/{agentId} - documento raiz del agente
    match /agents/{agentId} {
      // Agente lee su propio perfil; broker lee perfiles de sus agentes
      allow read:   if signedIn() && (uid() == agentId || (isBroker() && agentOwnedByMe(agentId)));
      // Solo el broker puede crear/actualizar el perfil del agente
      allow create: if isBroker();
      allow update: if signedIn() && (uid() == agentId || (isBroker() && agentOwnedByMe(agentId)));
      allow delete: if isBroker() && agentOwnedByMe(agentId);
    }

    // /agents/{agentId}/accounts/{docId}
    match /agents/{agentId}/accounts/{docId} {
      allow read, write: if signedIn() && uid() == agentId;
      allow read:        if isBroker() && agentOwnedByMe(agentId);
    }

    // /agents/{agentId}/transactions/{docId}
    match /agents/{agentId}/transactions/{docId} {
      allow read, write: if signedIn() && uid() == agentId;
      allow read:        if isBroker() && agentOwnedByMe(agentId);
    }

    // /agents/{agentId}/goals/{docId}
    match /agents/{agentId}/goals/{docId} {
      allow read, write: if signedIn() && uid() == agentId;
      allow read:        if isBroker() && agentOwnedByMe(agentId);
    }

    // /agents/{agentId}/cards/{docId}
    match /agents/{agentId}/cards/{docId} {
      allow read, write: if signedIn() && uid() == agentId;
      allow read:        if isBroker() && agentOwnedByMe(agentId);
    }

    // /agents/{agentId}/settings/{docId}
    // El broker puede escribir settings (habilidades)
    match /agents/{agentId}/settings/{docId} {
      allow read, write: if signedIn() && uid() == agentId;
      allow read, write: if isBroker() && agentOwnedByMe(agentId);
    }

    // /invites/{token}
    match /invites/{token} {
      allow read:   if signedIn();
      allow create: if isBroker();
      allow update: if signedIn();
      allow delete: if isBroker();
    }

  }
}
