rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return signedIn() && userRole() == 'admin'; }
    function isUser()  { return signedIn() && userRole() == 'user';  }

    // /users/{userId}
    match /users/{userId} {
      allow read:   if signedIn() && (uid() == userId || isAdmin());
      allow create: if signedIn() && uid() == userId;
      allow update: if signedIn() && (uid() == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // /admins/{adminId}
    match /admins/{adminId} {
      allow read:  if signedIn();          // cualquier usuario autenticado puede verificar si hay admins
      allow write: if signedIn() && uid() == adminId;
    }

    // /users_data/{userId} — perfil extendido
    match /users_data/{userId} {
      allow read, write: if signedIn() && uid() == userId;
      allow read, write: if isAdmin();
    }

    // /users_data/{userId}/accounts/{docId}
    match /users_data/{userId}/accounts/{docId} {
      allow read, write: if signedIn() && uid() == userId;
      allow read:        if isAdmin();
    }

    // /users_data/{userId}/transactions/{docId}
    match /users_data/{userId}/transactions/{docId} {
      allow read, write: if signedIn() && uid() == userId;
      allow read:        if isAdmin();
    }

    // /users_data/{userId}/goals/{docId}
    match /users_data/{userId}/goals/{docId} {
      allow read, write: if signedIn() && uid() == userId;
      allow read:        if isAdmin();
    }

    // /users_data/{userId}/cards/{docId}
    match /users_data/{userId}/cards/{docId} {
      allow read, write: if signedIn() && uid() == userId;
      allow read:        if isAdmin();
    }

    // /users_data/{userId}/settings/{docId}
    // Admin puede escribir settings (habilidades)
    match /users_data/{userId}/settings/{docId} {
      allow read, write: if signedIn() && uid() == userId;
      allow read, write: if isAdmin();
    }

    // /invites/{token}
    match /invites/{token} {
      allow read:   if signedIn();
      allow create: if isAdmin();
      allow update: if signedIn();
      allow delete: if isAdmin();
    }
  }
}
